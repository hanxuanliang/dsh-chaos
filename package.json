{
  "name": "@hanxuanliang/dsh-chaos",
  "version": "0.1.2",
  "description": "Peer multi-Agent collaboration for DeepSeek Harness",
  "type": "module",
  "license": "MIT",
  "author": "chxldxyz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hanxuanliang/dsh-chaos.git"
  },
  "bugs": {
    "url": "https://github.com/hanxuanliang/dsh-chaos/issues"
  },
  "homepage": "https://github.com/hanxuanliang/dsh-chaos#readme",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "multi-agent",
    "collaboration"
  ],
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "assets/readme/hero.svg",
    "release-notes",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@9.6.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "clean": "node scripts/clean-output.mjs",
    "clean:lib": "node scripts/clean-output.mjs lib",
    "build": "pnpm clean && pnpm build:native && pnpm build:ts && pnpm build:client",
    "build:package": "pnpm clean:lib && pnpm build:ts && pnpm build:client",
    "build:client": "tsdown --config tsdown.client.config.ts",
    "build:native": "cargo build -p dsh-chaos-core --features napi --release && node scripts/stage-native.mjs release",
    "build:native:debug": "cargo build -p dsh-chaos-core --features napi && node scripts/stage-native.mjs debug",
    "build:ts": "tsc -p tsconfig.json",
    "check:rust": "cargo check --workspace",
    "smoke:native": "node scripts/smoke-native.mjs",
    "smoke:packed": "node scripts/smoke-packed-release.mjs",
    "smoke:client": "node scripts/smoke-client.mjs",
    "smoke:remote": "node scripts/smoke-remote.mjs",
    "smoke:service": "node scripts/smoke-service.mjs",
    "smoke:runtime": "node scripts/smoke-runtime.mjs",
    "smoke:transport": "node scripts/smoke-web-transport.mjs",
    "prepare": "pnpm build:package",
    "prepublishOnly": "pnpm release:check",
    "public:check": "node scripts/check-public.mjs",
    "release:check": "node scripts/check-release.mjs",
    "test:e2e": "pnpm build:native:debug && pnpm build:ts && pnpm build:client && node e2e/run.mjs",
    "test:e2e:run": "node e2e/run.mjs",
    "test:rust": "cargo test --workspace",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-agent-loop": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-agent-presets": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-client-connection": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-layout": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.7",
    "@deepseek-ai/schemastery": "^3.18.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "0.1.0-rc.7",
    "@deepseek-ai/dsh-agent-loop": "0.1.0-rc.7",
    "@deepseek-ai/dsh-agent-presets": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-connection": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.7",
    "@deepseek-ai/dsh-host-webserver": "0.1.0-rc.7",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.7",
    "@deepseek-ai/dsh-session": "0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.7",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "lightningcss": "^1.32.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.3",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1"
  },
  "optionalDependencies": {
    "@hanxuanliang/dsh-chaos-darwin-arm64": "workspace:0.1.2",
    "@hanxuanliang/dsh-chaos-darwin-x64": "workspace:0.1.2",
    "@hanxuanliang/dsh-chaos-linux-x64-gnu": "workspace:0.1.2",
    "@hanxuanliang/dsh-chaos-win32-x64-msvc": "workspace:0.1.2"
  }
}
